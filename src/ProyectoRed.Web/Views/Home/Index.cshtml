@model List<InterfazRed>
@{
    ViewData["Title"] = "ProyectoRed";
}

<div class="text-center">

    <h1 class="display-4">ProyectoRed</h1>

    <p class="lead">
        Identificador local de dispositivos de red
    </p>

</div>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h2 class="h4 mb-4">
                    Detección de dispositivo
                </h2>

                <div class="mb-3">

                    <label for="interfazRed" class="form-label">
                        Interfaz de red
                    </label>

                    <select id="interfazRed" class="form-select">

                        <option value="">
                            Seleccione una interfaz...
                        </option>

                        @foreach (InterfazRed interfaz in Model)
                        {
                            <option
                                value="@interfaz.Nombre"
                                data-ip="@interfaz.DireccionIP">
                                @interfaz.Nombre
                            </option>
                        }

                    </select>

                    <div class="form-text" id="estadoInterfaz">
                        IPv4 actual: seleccione una interfaz.
                    </div>

                </div>

                <div class="border rounded p-3 mb-3">

                    <h3 class="h6 mb-2">
                        Búsqueda de dispositivo
                    </h3>

                    <p class="small text-muted mb-3">
                        Puede buscar automáticamente, por IP o por MAC.
                        La búsqueda por MAC utiliza la identidad física del equipo
                        para localizar su IPv4 actual.
                    </p>

                    <div class="mb-3">
                        <label
                            for="modoBusqueda"
                            class="form-label">
                            Modo de búsqueda
                        </label>

                        <select
                            id="modoBusqueda"
                            class="form-select">
                            <option value="automatica">
                                Automática
                            </option>
                            <option value="ip">
                                Por IP
                            </option>
                            <option value="mac">
                                Por MAC
                            </option>
                        </select>
                    </div>

                    <div
                        id="campoIpBusqueda"
                        class="mb-0 d-none">

                        <label
                            for="direccionIpObjetivo"
                            class="form-label">
                            IP del dispositivo
                        </label>

                        <input
                            id="direccionIpObjetivo"
                            type="text"
                            class="form-control"
                            placeholder="Ej. 192.168.0.1">

                        <div class="form-text">
                            Realiza una consulta ARP dirigida contra esa IPv4.
                            Si ya existe un registro histórico para esa IP,
                            ProyectoRed puede reutilizar su MAC y buscar la IPv4 actual.
                        </div>

                    </div>

                    <div
                        id="campoMacBusqueda"
                        class="mb-0 d-none">

                        <label
                            for="direccionMacObjetivo"
                            class="form-label">
                            MAC del dispositivo
                        </label>

                        <input
                            id="direccionMacObjetivo"
                            type="text"
                            class="form-control"
                            placeholder="Ej. AA:BB:CC:DD:EE:FF">

                        <div class="form-text">
                            Acepta AA:BB:CC:DD:EE:FF, AA-BB-CC-DD-EE-FF
                            o AABBCCDDEEFF. La MAC permite localizar la IP
                            aunque el dispositivo haya cambiado de red.
                        </div>

                    </div>

                </div>

                <div class="d-grid">

                    <button
                        id="btnComenzar"
                        type="button"
                        class="btn btn-primary">
                        Comenzar
                    </button>

                </div>

                <div class="mt-4">

                    <div
                        id="tiemposDeteccion"
                        class="alert alert-light border d-none mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 col-md-4">
                                <strong>Tiempo transcurrido:</strong>
                                <span id="tiempoTranscurrido">0.0 s</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <strong>Tiempo estimado:</strong>
                                <span id="tiempoEstimado">--</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <strong>Fase:</strong>
                                <span id="faseDeteccion">Preparando...</span>
                            </div>
                        </div>
                    </div>

                    <p class="mb-3">
                        <strong>Estado:</strong>
                        <span id="estadoDeteccion">Esperando</span>
                    </p>

                    <div
                        id="alertaResultadoDeteccion"
                        class="alert alert-danger d-none mb-3"
                        role="alert">
                        <strong>No se pudo identificar el dispositivo.</strong>
                        <div
                            id="detalleFalloDeteccion"
                            class="mt-1">
                        </div>
                    </div>

                    <div id="resultadoDeteccion" class="card d-none">

                        <div class="card-body">

                            <h3 class="h5 mb-3">
                                Resultado de la detección
                            </h3>

                            <p class="mb-2">
                                <strong>Enlace UTP:</strong>
                                <span id="resultadoEnlace">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-2">
                                <strong>IP:</strong>
                                <span id="resultadoIp">No disponible</span>
                            </p>

                            <p class="mb-2">
                                <strong>MAC:</strong>
                                <span id="resultadoMac">No disponible</span>
                            </p>

                            <p class="mb-2">
                                <strong>Fabricante:</strong>
                                <span id="resultadoFabricante">No identificado</span>
                            </p>

                            <p class="mb-3">
                                <strong>IPv4:</strong>
                                <span id="resultadoTipoDireccion">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-3">
                                <strong>Método:</strong>
                                <span id="resultadoMetodo">No disponible</span>
                            </p>

                            <p class="mb-3">
                                <strong>Criterio:</strong>
                                <span id="resultadoCriterioBusqueda">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-2 small text-muted">
                                Máscara local:
                                <span id="resultadoMascaraLocal">No disponible</span>
                            </p>

                            <p class="mb-3 small text-muted">
                                Sondas ARP enviadas:
                                <span id="resultadoSondasArp">0</span>
                            </p>

                            <div id="metodosAcceso" class="alert alert-light border d-none mt-3 mb-3">
                                <strong>Métodos de acceso detectados</strong>
                                <div
                                    id="listaMetodosAcceso"
                                    class="mt-2">
                                </div>
                            </div>

                            <div id="accesoDispositivo" class="mt-3">
                                <div
                                    id="mensajeAcceso"
                                    class="alert d-none mt-3 mb-0"
                                    role="alert">
                                </div>

                                <div
                                    id="configuracionManual"
                                    class="alert alert-warning d-none mt-3 mb-0"
                                    role="alert">
                                    <strong>Configuración temporal de acceso</strong>
                                    <div class="mt-2">
                                        <div>
                                            <strong>IP:</strong>
                                            <span id="configuracionIp"></span>
                                        </div>
                                        <div>
                                            <strong>Máscara:</strong>
                                            <span id="configuracionMascara"></span>
                                        </div>
                                        <div>
                                            <strong>Puerta de enlace:</strong>
                                            <span id="configuracionGateway">Dejar vacía</span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        Después de aplicar temporalmente esta configuración
                                        en la interfaz Ethernet, vuelva a pulsar «Comenzar».
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
