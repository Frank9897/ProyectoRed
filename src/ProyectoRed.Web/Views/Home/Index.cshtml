@model List<InterfazRed>
@{
    ViewData["Title"] = "ProyectoRed";
}

<div class="text-center">

    <h1 class="display-4">ProyectoRed</h1>

    <p class="lead">
        Identificador local de dispositivos de red
    </p>

</div>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h2 class="h4 mb-4">
                    Detección de dispositivo
                </h2>

                <div class="mb-3">

                    <label for="interfazRed" class="form-label">
                        Interfaz de red
                    </label>

                    <select id="interfazRed" class="form-select">

                        <option value="">
                            Seleccione una interfaz...
                        </option>

                        @foreach (InterfazRed interfaz in Model)
                        {
                            <option
                                value="@interfaz.Nombre"
                                data-ip="@interfaz.DireccionIP">
                                @interfaz.Nombre
                            </option>
                        }

                    </select>

                    <div class="form-text" id="estadoInterfaz">
                        IPv4 actual: seleccione una interfaz.
                    </div>

                </div>

                <div class="border rounded p-3 mb-3">

                    <h3 class="h6 mb-2">
                        Detección manual
                    </h3>

                    <p class="small text-muted mb-3">
                        Úsela cuando el dispositivo tiene una IP conocida
                        pero la PC no tiene IPv4, DHCP o puerta de enlace.
                        No modifica la configuración de Windows.
                    </p>

                    <div class="mb-3">

                        <label
                            for="direccionIpObjetivo"
                            class="form-label">
                            IP del dispositivo
                        </label>

                        <input
                            id="direccionIpObjetivo"
                            type="text"
                            class="form-control"
                            placeholder="Ej. 192.168.0.1">

                        <div class="form-text">
                            La consulta ARP manual se realizará únicamente contra esta IP.
                        </div>

                    </div>

                    <div class="mb-0">

                        <label
                            for="direccionIpLocalManual"
                            class="form-label">
                            IP local de prueba
                        </label>

                        <input
                            id="direccionIpLocalManual"
                            type="text"
                            class="form-control"
                            placeholder="Ej. 192.168.0.2">

                        <div class="form-text">
                            Opcional. Se usa como IP de origen de la consulta ARP
                            si la interfaz no tiene una IPv4 configurada.
                        </div>

                    </div>

                </div>

                <div class="d-grid">

                    <button
                        id="btnComenzar"
                        type="button"
                        class="btn btn-primary">
                        Comenzar
                    </button>

                </div>

                <div class="mt-4">

                    <p class="mb-3">
                        <strong>Estado:</strong>
                        <span id="estadoDeteccion">Esperando</span>
                    </p>

                    <div id="resultadoDeteccion" class="card d-none">

                        <div class="card-body">

                            <h3 class="h5 mb-3">
                                Resultado de la detección
                            </h3>

                            <p class="mb-2">
                                <strong>Enlace UTP:</strong>
                                <span id="resultadoEnlace">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-2">
                                <strong>IP:</strong>
                                <span id="resultadoIp">No disponible</span>
                            </p>

                            <p class="mb-2">
                                <strong>MAC:</strong>
                                <span id="resultadoMac">No disponible</span>
                            </p>

                            <p class="mb-3">
                                <strong>IPv4:</strong>
                                <span id="resultadoTipoDireccion">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-3">
                                <strong>Nombre:</strong>
                                <span id="resultadoNombre">No disponible</span>
                            </p>

                            <div id="accesoDispositivo" class="mt-3">
                                <button
                                    id="btnAbrirInterfaz"
                                    type="button"
                                    class="btn btn-success">
                                    Abrir interfaz del dispositivo
                                </button>

                                <div
                                    id="mensajeAcceso"
                                    class="alert d-none mt-3 mb-0"
                                    role="alert">
                                </div>

                                <div
                                    id="configuracionManual"
                                    class="alert alert-warning d-none mt-3 mb-0"
                                    role="alert">
                                    <strong>Configuración manual sugerida</strong>
                                    <div class="mt-2">
                                        <div>
                                            <strong>IP:</strong>
                                            <span id="configuracionIp"></span>
                                        </div>
                                        <div>
                                            <strong>Máscara:</strong>
                                            <span id="configuracionMascara"></span>
                                        </div>
                                        <div>
                                            <strong>Puerta de enlace:</strong>
                                            <span id="configuracionGateway">Dejar vacía</span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        Después de aplicar temporalmente esta configuración
                                        en la interfaz Ethernet, vuelva a pulsar el botón.
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
