@model List<InterfazRed>
@{
    ViewData["Title"] = "ProyectoRed";
}

<div class="text-center">

    <h1 class="display-4">ProyectoRed</h1>

    <p class="lead">
        Identificador local de dispositivos de red
    </p>

</div>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h2 class="h4 mb-4">
                    Detección de dispositivo
                </h2>

                <div class="mb-3">

                    <label for="interfazRed" class="form-label">
                        Interfaz de red
                    </label>

                    <select id="interfazRed" class="form-select">

                        <option value="">
                            Seleccione una interfaz...
                        </option>

                        @foreach (InterfazRed interfaz in Model)
                        {
                            <option value="@interfaz.Nombre">
                                @interfaz.Nombre
                            </option>
                        }

                    </select>

                </div>

                <div class="d-grid">

                    <button
                        id="btnComenzar"
                        type="button"
                        class="btn btn-primary">
                        Comenzar
                    </button>

                </div>

                <div class="mt-4">

                    <p class="mb-3">
                        <strong>Estado:</strong>
                        <span id="estadoDeteccion">Esperando</span>
                    </p>

                    <div id="resultadoDeteccion" class="card d-none">

                        <div class="card-body">

                            <h3 class="h5 mb-3">
                                Dispositivo detectado
                            </h3>

                            <p class="mb-2">
                                <strong>IP:</strong>
                                <span id="resultadoIp">No disponible</span>
                            </p>

                            <p class="mb-2">
                                <strong>MAC:</strong>
                                <span id="resultadoMac">No disponible</span>
                            </p>

                            <p class="mb-0">
                                <strong>Nombre:</strong>
                                <span id="resultadoNombre">No disponible</span>
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
