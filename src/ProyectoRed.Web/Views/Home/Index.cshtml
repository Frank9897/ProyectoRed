@model List<InterfazRed>
@{
    ViewData["Title"] = "ProyectoRed";
}

<div class="text-center">

    <h1 class="display-4">ProyectoRed</h1>

    <p class="lead">
        Identificador local de dispositivos de red
    </p>

</div>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h2 class="h4 mb-4">
                    Detección de dispositivo
                </h2>

                <div class="mb-3">

                    <label for="interfazRed" class="form-label">
                        Interfaz de red
                    </label>

                    <select id="interfazRed" class="form-select">

                        <option value="">
                            Seleccione una interfaz...
                        </option>

                        @foreach (InterfazRed interfaz in Model)
                        {
                            <option
                                value="@interfaz.Nombre"
                                data-ip="@interfaz.DireccionIP">
                                @interfaz.Nombre
                            </option>
                        }

                    </select>

                    <div class="form-text" id="estadoInterfaz">
                        IPv4 actual: seleccione una interfaz.
                    </div>

                </div>

                <div class="border rounded p-3 mb-3">

                    <h3 class="h6 mb-2">
                        Detección automática y manual
                    </h3>

                    <p class="small text-muted mb-3">
                        Deje la IP vacía para iniciar la búsqueda automática.
                        ProyectoRed escucha LLDP/CDP/STP y realiza
                        sondeos ARP sobre la red local cuando es posible.
                        No modifica la configuración de Windows.
                    </p>

                    <div class="mb-0">

                        <label
                            for="direccionIpObjetivo"
                            class="form-label">
                            IP del dispositivo
                        </label>

                        <input
                            id="direccionIpObjetivo"
                            type="text"
                            class="form-control"
                            placeholder="Ej. 192.168.0.1">

                        <div class="form-text">
                            Opcional. Si se completa, se realiza una única consulta ARP
                            contra esa IPv4 y no se ejecuta el sondeo automático.
                        </div>

                    </div>

                </div>

                <div class="d-grid">

                    <button
                        id="btnComenzar"
                        type="button"
                        class="btn btn-primary">
                        Comenzar
                    </button>

                </div>

                <div class="mt-4">

                    <div
                        id="tiemposDeteccion"
                        class="alert alert-light border d-none mb-3">
                        <div class="row g-2 small">
                            <div class="col-12 col-md-4">
                                <strong>Tiempo transcurrido:</strong>
                                <span id="tiempoTranscurrido">0.0 s</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <strong>Estimación:</strong>
                                <span id="tiempoEstimado">--</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <strong>Fase:</strong>
                                <span id="faseDeteccion">Preparando...</span>
                            </div>
                        </div>
                    </div>

                    <p class="mb-3">
                        <strong>Estado:</strong>
                        <span id="estadoDeteccion">Esperando</span>
                    </p>

                    <div id="resultadoDeteccion" class="card d-none">

                        <div class="card-body">

                            <h3 class="h5 mb-3">
                                Resultado de la detección
                            </h3>

                            <p class="mb-2">
                                <strong>Enlace UTP:</strong>
                                <span id="resultadoEnlace">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-2">
                                <strong>IP:</strong>
                                <span id="resultadoIp">No disponible</span>
                            </p>

                            <p class="mb-2">
                                <strong>MAC:</strong>
                                <span id="resultadoMac">No disponible</span>
                            </p>

                            <p class="mb-3">
                                <strong>IPv4:</strong>
                                <span id="resultadoTipoDireccion">
                                    No disponible
                                </span>
                            </p>

                            <p class="mb-3">
                                <strong>Nombre:</strong>
                                <span id="resultadoNombre">No disponible</span>
                            </p>

                            <p class="mb-3">
                                <strong>Método:</strong>
                                <span id="resultadoMetodo">No disponible</span>
                            </p>

                            <p class="mb-2 small text-muted">
                                Tiempo real:
                                <span id="resultadoTiempo">No disponible</span>
                            </p>

                            <p class="mb-3 small text-muted">
                                Sondas ARP:
                                <span id="resultadoSondasArp">0</span>
                            </p>

                            <div id="accesoDispositivo" class="mt-3">
                                <button
                                    id="btnAbrirInterfaz"
                                    type="button"
                                    class="btn btn-success">
                                    Abrir interfaz del dispositivo
                                </button>

                                <div
                                    id="mensajeAcceso"
                                    class="alert d-none mt-3 mb-0"
                                    role="alert">
                                </div>

                                <div
                                    id="configuracionManual"
                                    class="alert alert-warning d-none mt-3 mb-0"
                                    role="alert">
                                    <strong>Configuración manual sugerida</strong>
                                    <div class="mt-2">
                                        <div>
                                            <strong>IP:</strong>
                                            <span id="configuracionIp"></span>
                                        </div>
                                        <div>
                                            <strong>Máscara:</strong>
                                            <span id="configuracionMascara"></span>
                                        </div>
                                        <div>
                                            <strong>Puerta de enlace:</strong>
                                            <span id="configuracionGateway">Dejar vacía</span>
                                        </div>
                                    </div>
                                    <div class="mt-2">
                                        Después de aplicar temporalmente esta configuración
                                        en la interfaz Ethernet, vuelva a pulsar el botón.
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="text-center mt-3 mb-4">
        <a
            href="/Home/DescargarPruebaWindows"
            class="btn btn-outline-secondary">
            Opcional: diagnóstico con Windows
        </a>
        <div class="form-text mt-2">
            Descarga un .bat que usa las herramientas nativas de Windows
            para intentar obtener una unica relacion IPv4 + MAC en Ethernet.
            Si Windows encuentra varios vecinos, no selecciona ninguno.
        </div>
    </div>
</div>
